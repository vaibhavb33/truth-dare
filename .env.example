# ==============================================================================
# PROJECT ASTERIA — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development. Set in Vercel / hosting dashboard for production.
# ==============================================================================

# Application URL (Canonical root for SEO and sitemap generation)
NEXT_PUBLIC_APP_URL="https://truthordarequiz.com"
NEXT_PUBLIC_SITE_URL="https://truthordarequiz.com"

# Supabase Public API Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-public-anon-key"

# Supabase Server-Only Secret Key (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Admin Authentication Secrets
ADMIN_JWT_SECRET="generate-a-strong-32-char-random-secret-for-production"
ADMIN_DEFAULT_PASSWORD="replace-with-complex-superadmin-password"

# Optional Error Monitoring (Sentry)
# NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# Optional Web Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

